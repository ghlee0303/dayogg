# docker compose 실행용 환경변수 예시 — 복사해서 .env 로 사용
# cp .env.example .env

# RDS(MySQL) 접속 정보
DB_HOST=your-db.xxxxxx.ap-northeast-2.rds.amazonaws.com   # RDS 엔드포인트
DB_USERNAME=er_db
DB_PASSWORD=change-me

# 배포된 프론트 출처 (CORS 허용). 콤마로 여러 개 가능. 끝에 슬래시/경로 없이 출처만.
#   예: https://app.example.com  또는  https://d1234.cloudfront.net
CORS_ALLOWED_ORIGINS=https://your-frontend-domain

# 이터널리턴 오픈 API 키
GAME_API_KEY=your-bser-api-key
GAME_API_URL=https://open-api.bser.io

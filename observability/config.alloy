// 로컬 전용 로그 수집기.
// 앱이 떨구는 logs/app.json (ECS JSON, 1줄 1이벤트) 을 tail 해서 Loki 로 보낸다.
// IntelliJ 로 띄우면 stdout 을 못 긁으므로 파일을 읽는다.
//
// 경로는 run-local.ps1 이 APP_LOG_PATH 로 넣어준다.
// 직접 띄울 때를 위한 기본값은 작업 디렉터리(observability/) 기준 상대 경로다.

local.file_match "applog" {
	path_targets = [{
		__path__ = coalesce(sys.env("APP_LOG_PATH"), "../logs/app.json"),
		job      = "statistics",
	}]
}

loki.source.file "applog" {
	targets    = local.file_match.applog.targets
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://localhost:3100/loki/api/v1/push"
	}
}

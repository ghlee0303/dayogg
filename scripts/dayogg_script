#!/usr/bin/env bash
# dayogg — docker compose 배포 관리 래퍼
#
# 사용법: dayogg <명령>
#   status | ps        컨테이너 상태
#   stats              리소스 사용량 (CPU/메모리)
#   logs [서비스]      로그 실시간 (기본 app, 예: dayogg logs mysql)
#   start              멈춘 컨테이너 재개
#   stop               컨테이너 정지 (삭제 안 함)
#   restart [서비스]   재시작
#   up | deploy        정리(clean) 후 새 이미지 pull → 기동 (수동 배포, 디스크 자동 확보)
#   down               내리기 (⚠️ 컨테이너 삭제, DB 볼륨은 유지)
#   pull               이미지만 최신으로 받기
#   clean              디스크 정리 (안 쓰는 이미지/빌드캐시/정지 컨테이너, ⚠️ 볼륨은 안 건드림)
#   db-reset           DB 전체 행 + Redis 캐시 삭제 (⚠️⚠️ 되돌릴 수 없음, RESET 입력 확인)
#
# 설정(환경변수로 덮어쓰기 가능):
#   DAYOGG_DIR   compose 파일이 있는 폴더 (기본: ~/dayogg)
#   DAYOGG_FILE  compose 파일명       (기본: docker-compose.prod.yml)

set -euo pipefail

DIR="${DAYOGG_DIR:-$HOME/dayogg}"
FILE="${DAYOGG_FILE:-docker-compose.prod.yml}"

# compose 파일 존재 확인
if [ ! -f "$DIR/$FILE" ]; then
  echo "❌ compose 파일을 찾을 수 없음: $DIR/$FILE" >&2
  echo "   DAYOGG_DIR / DAYOGG_FILE 환경변수를 확인하세요." >&2
  exit 1
fi

cd "$DIR"
dc() { docker compose -f "$FILE" "$@"; }

# 안 쓰는 이미지/빌드캐시/정지 컨테이너 정리. 볼륨(DB 데이터)은 절대 건드리지 않음.
# 실행 중인 컨테이너가 물고 있는 이미지는 미참조가 아니라 삭제 대상이 아님 → DB 안전.
prune_unused() {
  echo "🧹 미참조 이미지 정리..."
  docker image prune -af
  echo "🧹 빌드 캐시 정리..."
  docker builder prune -af
  echo "🧹 정지된 컨테이너 정리..."
  docker container prune -f
}

cmd="${1:-status}"   # 인자 없으면 status
shift || true

case "$cmd" in
  status|ps)
    dc ps
    ;;
  stats)
    docker stats --no-stream
    ;;
  logs)
    svc="${1:-app}"   # 기본 app
    dc logs -f "$svc"
    ;;
  start)
    dc start
    echo "✅ started"
    ;;
  stop)
    dc stop
    echo "✅ stopped (컨테이너 유지, 'dayogg start'로 재개)"
    ;;
  restart)
    dc restart "$@"
    echo "✅ restarted"
    ;;
  up|deploy)
    # 디스크 부족(no space left)은 새 이미지를 받는 pull 단계에서 터지므로,
    # pull '전에' 먼저 정리해 공간을 확보한다.
    echo "== 배포 전 디스크 =="
    df -h "$DIR" | tail -1
    prune_unused
    echo "== 정리 후 디스크 =="
    df -h "$DIR" | tail -1
    echo
    echo "⬇️  새 이미지 pull..."
    dc pull
    dc up -d
    docker image prune -f    # 방금 교체돼 미참조가 된 옛 이미지 즉시 회수
    echo "✅ deployed"
    dc ps
    ;;
  pull)
    dc pull
    ;;
  down)
    dc down
    echo "✅ down (DB 볼륨은 유지됨. 데이터까지 지우려면: dayogg down -v 대신 수동으로)"
    ;;
  clean)
    echo "== 정리 전 =="
    df -h "$DIR" | tail -1
    docker system df
    echo
    prune_unused
    echo
    echo "== 정리 후 =="
    df -h "$DIR" | tail -1
    echo "✅ cleaned (볼륨은 유지됨)"
    ;;
  db-reset)
    # ⚠️ 되돌릴 수 없다. 모든 테이블의 행과 Redis 캐시를 지운다.
    # 테이블 자체는 남긴다 — 운영은 JPA_DDL_AUTO=validate 라 테이블이 사라지면 앱이 기동하지 못한다.
    [ -f .env ] || { echo "❌ .env 를 찾을 수 없음: $DIR/.env" >&2; exit 1; }
    set -a; . ./.env; set +a

    : "${DB_HOST:?.env 에 DB_HOST 가 없음}"
    : "${DB_PASSWORD:?.env 에 DB_PASSWORD 가 없음}"
    db_user="${DB_USERNAME:-er_db}"
    db_name="${DAYOGG_DB:-eternal_return}"

    # 옵션은 DB 이름 앞에 와야 하므로 "$@" 를 가운데 둔다. 비밀번호는 MYSQL_PWD 로 넘겨 프롬프트를 피한다.
    my() {
      docker run --rm -i -e MYSQL_PWD="$DB_PASSWORD" mysql:8 \
        mysql -h "$DB_HOST" -u "$db_user" "$@" "$db_name"
    }

    echo "⚠️  대상: $db_name @ $DB_HOST"
    echo "    모든 테이블의 행과 Redis 캐시를 전부 지웁니다. 되돌릴 수 없습니다."
    printf "    계속하려면 RESET 을 입력하세요: "
    read -r answer
    [ "$answer" = "RESET" ] || { echo "취소됨"; exit 1; }

    # 목록을 하드코딩하면 엔티티가 늘 때마다 스크립트가 낡는다. 스키마에서 직접 읽는다.
    tables=$(my -N -B -e \
      "SELECT table_name FROM information_schema.tables
        WHERE table_schema = '$db_name' AND table_type = 'BASE TABLE';")
    [ -n "$tables" ] || { echo "❌ 테이블이 없음. DB 이름/접속 정보를 확인." >&2; exit 1; }

    echo "🛑 앱 정지 (비우는 중 쓰기 차단)..."
    dc stop app

    echo "🗑  비울 테이블:"
    echo "$tables" | sed 's/^/     /'
    {
      # FK 순서를 맞추는 대신 검사를 잠시 끈다. TRUNCATE 는 AUTO_INCREMENT 도 1로 되돌린다.
      echo "SET FOREIGN_KEY_CHECKS = 0;"
      echo "$tables" | while read -r t; do echo "TRUNCATE TABLE \`$t\`;"; done
      echo "SET FOREIGN_KEY_CHECKS = 1;"
    } | my

    # 안 하면 DB 는 비었는데 옛 통계·티어컷이 캐시에서 계속 조회된다.
    echo "🧼 Redis 캐시 삭제..."
    dc start redis
    dc exec -T redis redis-cli FLUSHALL

    echo "🚀 재기동..."
    dc up -d
    echo "✅ db-reset 완료"
    dc ps
    ;;
  -h|--help|help)
    # 선두 주석 블록만 출력 (첫 비주석 라인에서 멈춤)
    awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"
    ;;
  *)
    echo "알 수 없는 명령: $cmd" >&2
    echo "사용 가능: status stats logs start stop restart up down pull clean db-reset  (dayogg help)" >&2
    exit 1
    ;;
esac

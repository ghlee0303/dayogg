#!/usr/bin/env bash
# dayogg — docker compose 배포 관리 래퍼
#
# 사용법: dayogg <명령>
#   status | ps        컨테이너 상태
#   stats              리소스 사용량 (CPU/메모리)
#   logs [서비스]      로그 실시간 (기본 app, 예: dayogg logs mysql)
#   start              멈춘 컨테이너 재개
#   stop               컨테이너 정지 (삭제 안 함)
#   restart [서비스]   재시작
#   up | deploy        새 이미지 pull 후 기동 (수동 배포)
#   down               내리기 (⚠️ 컨테이너 삭제, DB 볼륨은 유지)
#   pull               이미지만 최신으로 받기
#
# 설정(환경변수로 덮어쓰기 가능):
#   DAYOGG_DIR   compose 파일이 있는 폴더 (기본: ~/dayogg)
#   DAYOGG_FILE  compose 파일명       (기본: docker-compose.prod.yml)

set -euo pipefail

DIR="${DAYOGG_DIR:-$HOME/dayogg}"
FILE="${DAYOGG_FILE:-docker-compose.prod.yml}"

# compose 파일 존재 확인
if [ ! -f "$DIR/$FILE" ]; then
  echo "❌ compose 파일을 찾을 수 없음: $DIR/$FILE" >&2
  echo "   DAYOGG_DIR / DAYOGG_FILE 환경변수를 확인하세요." >&2
  exit 1
fi

cd "$DIR"
dc() { docker compose -f "$FILE" "$@"; }

cmd="${1:-status}"   # 인자 없으면 status
shift || true

case "$cmd" in
  status|ps)
    dc ps
    ;;
  stats)
    docker stats --no-stream
    ;;
  logs)
    svc="${1:-app}"   # 기본 app
    dc logs -f "$svc"
    ;;
  start)
    dc start
    echo "✅ started"
    ;;
  stop)
    dc stop
    echo "✅ stopped (컨테이너 유지, 'dayogg start'로 재개)"
    ;;
  restart)
    dc restart "$@"
    echo "✅ restarted"
    ;;
  up|deploy)
    dc pull
    dc up -d
    docker image prune -f
    echo "✅ deployed"
    dc ps
    ;;
  pull)
    dc pull
    ;;
  down)
    dc down
    echo "✅ down (DB 볼륨은 유지됨. 데이터까지 지우려면: dayogg down -v 대신 수동으로)"
    ;;
  -h|--help|help)
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "알 수 없는 명령: $cmd" >&2
    echo "사용 가능: status stats logs start stop restart up down pull  (dayogg help)" >&2
    exit 1
    ;;
esac
